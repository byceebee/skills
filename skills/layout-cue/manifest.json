{
  "manifest_version": 3,
  "name": "Layout Cue",
  "version": "0.3.2",
  "description": "Keep layout guides on the active tab and check its rendered geometry.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*;"
  },
  "action": {
    "default_title": "Layout Cue",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/icons/16.png",
      "32": "extension/icons/32.png"
    }
  },
  "background": {
    "service_worker": "extension/background.mjs",
    "type": "module"
  },
  "icons": {
    "16": "extension/icons/16.png",
    "32": "extension/icons/32.png",
    "48": "extension/icons/48.png",
    "128": "extension/icons/128.png"
  },
  "minimum_chrome_version": "116"
}
